# mabubot-ops の環境変数の見本。コピーして .env を作り、値を入れること。
# 実トークンをリポジトリに含めないこと。

# Discord のトークン（必須。mabubot-ops 専用の新しいアプリケーションを使うこと。
# 元の mabubot や他の mabubot-* のアプリは使い回さない）
DISCORD_TOKEN=
# Discord アプリケーション ID（必須。コマンド同期・削除に使う）
DISCORD_APPLICATION_ID=
# SQLite データの保存先（任意。既定は ./data で、data/mabubot-ops.db に保存される）
DATA_DIR=./data
# 起動時 DB バックアップの保持世代数（任意。既定は 10）
DB_BACKUP_RETENTION=10
